<?php

// Accurate types for redis/ranking 1.3 (its docblocks say int everywhere;
// members are strings and phpredis returns floats for scores and false for a
// missing member). Only the methods this app calls; countUsers(),
// deleteUser() and deleteAllUser() are left out on purpose: they call
// zSize()/zDelete(), which phpredis 6 removed.

namespace Matsubo\Redis;

class Ranking
{
    /** @param string $namespace */
    public function __construct($namespace = '', ?\Redis $redis = null) {}

    /**
     * @param string $user_id
     * @param int|float $score
     * @return int|false
     */
    public function setUserScore($user_id, $score) {}

    /**
     * @param string $user_id
     * @return float|false
     */
    public function getScore($user_id) {}

    /**
     * @param string $user_id
     * @return int|false 0-based, lowest score first
     */
    public function getRank($user_id) {}

    /**
     * @param string $user_id
     * @param int|float $score_diff
     * @return float|false
     */
    public function incrementScore($user_id, $score_diff) {}

    /**
     * Numeric member names come back as int keys/values.
     *
     * @param int $start
     * @param int $end
     * @param bool $withscores
     * @return ($withscores is true ? array<string|int, float> : list<string|int>)|false
     */
    public function getRange($start = 0, $end = -1, $withscores = false) {}
}
